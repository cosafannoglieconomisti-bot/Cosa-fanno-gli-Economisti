# Copia in .env e compila. Un solo file in radice — tutti gli script lo leggono da qui.

# --- Gemini (titoli AI, analisi) ---
GEMINI_API_KEY=
# dove: https://aistudio.google.com/apikey
# senza: ./workflow paper usa solo titoli di ripiego/template

# Modello Gemini (default: gemini-2.0-flash)
GEMINI_MODEL=

# --- Buffer / Social (OPZIONALE se non usi Instagram via Buffer) ---
BUFFER_ACCESS_TOKEN=
# dove: buffer.com → Settings → Apps & Extras → token
# senza: ./workflow upload e instagram falliscono su Buffer

BUFFER_ORG_ID=
# dove: pannello Buffer → Organization settings
# senza: scheduling Buffer non funziona

FB_PROFILE_ID=
# dove: Buffer → profili collegati
# senza: post Facebook (attualmente sospeso) non funzionano

IG_PROFILE_ID=
# dove: Buffer → profili collegati
# senza: ./workflow instagram fallisce

# --- Telegram (OPZIONALE — Cesare legacy) ---
TELEGRAM_TOKEN=
# dove: @BotFather su Telegram
# senza: bot Telegram non risponde

ALLOWED_CHAT_ID=
ALLOWED_ID=
# dove: ID chat/utente Telegram autorizzati
# senza: bot rifiuta i comandi

# --- Supermemory (OPZIONALE) ---
SUPERMEMORY_API_KEY=
SUPERMEMORY_PROJECT_ID=
# dove: dashboard Supermemory
# senza: ingest/verifica memoria disabilitati
